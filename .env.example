# Entorno y puerto del servidor HTTP
NODE_ENV=production
PORT=4000

# Secreto para firmar tokens JWT (usa una cadena larga y aleatoria en producción)
JWT_SECRET=cambia_este_secreto_por_una_clave_larga_y_aleatoria

# Configuración de MySQL / MariaDB (usa variables individuales o DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rcv_db
DB_CONNECTION_LIMIT=10
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_URL=mysql://usuario:clave@host:3306/rcv_db?ssl=true

# Orígenes permitidos para CORS (separados por coma; en producción coloca tu dominio HTTPS)
CORS_ORIGIN=http://localhost:4000

# Superadmin de emergencia (para recuperación ante corrupción o pérdida de tabla users)
EMERGENCY_SUPERADMIN_USER=superadmin
EMERGENCY_SUPERADMIN_EMAIL=superadmin@rcv.local
EMERGENCY_SUPERADMIN_PASSWORD=cambia_esta_clave_de_emergencia_fuerte
